# Server
ENV=development
PORT=8080
API_URL=http://localhost:8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=financeapp
DB_SSLMODE=disable

# JWT
JWT_SECRET=your-super-secret-key-min-32-chars
JWT_EXPIRY=1h
REFRESH_SECRET=another-secret-key-min-32-chars
REFRESH_EXPIRY=720h

# Email
EMAIL_FROM=noreply@yourapp.com
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-key

# Frontend
FRONTEND_URL=http://localhost:5173

# Tink API
TINK_CLIENT_ID=your-client-id
TINK_CLIENT_SECRET=your-secret
TINK_ENVIRONMENT=sandbox

# Encryption
ENCRYPTION_KEY=32-character-key-for-aes-256-encryption